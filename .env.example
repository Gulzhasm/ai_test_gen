# ============================================================
# Environment configuration — copy to .env and fill in values
#   cp .env.example .env
# ============================================================

# --- Azure DevOps (required) --------------------------------
ADO_ORG=your-org
ADO_PROJECT=YourProject
ADO_PAT=your_personal_access_token_here
ADO_AREA_PATH=YourProject\QA Team
ASSIGNED_TO=qa.engineer@example.com
DEFAULT_STATE=Design

# --- Output -------------------------------------------------
OUTPUT_DIR=output

# --- LLM refinement (stage 5 of the pipeline) ---------------
# Provider options: openai | gemini | anthropic | ollama
# Recommended: anthropic / claude-opus-5-5 (needs ANTHROPIC_API_KEY)
LLM_ENABLED=true
LLM_PROVIDER=anthropic
LLM_MODEL=claude-opus-5-5
# Anthropic only: effort low|medium|high|xhigh|max (Opus 5.5 defaults to medium when unset)
ANTHROPIC_EFFORT=high
LLM_TIMEOUT=120
LLM_TEMPERATURE=0.2

# --- Cross-model LLM Judge (stage 7 of the pipeline) --------
# Keep the judge on a DIFFERENT model than the generator, so no model reviews its own
# output (a different provider adds independence; deterministic reviewer-rule checks
# run in the judge loop either way when qa_rules.strict_grounding is on).
SELF_JUDGE_ENABLED=false
JUDGE_ENABLED=true
JUDGE_PROVIDER=anthropic
JUDGE_MODEL=claude-sonnet-5-5
JUDGE_MAX_ROUNDS=2
JUDGE_AUTO_FIX=true
JUDGE_TIMEOUT=120

# --- API keys (at least one required when LLM_ENABLED=true) -
OPENAI_API_KEY=sk-your-api-key-here
GEMINI_API_KEY=your-gemini-key-here
ANTHROPIC_API_KEY=your-anthropic-key-here
